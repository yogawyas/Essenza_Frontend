# Optional for debug builds using the shared development project.
# To override the project, copy to .env, fill both values, and restart Metro.
# Use a project URL and sb_publishable_ key from the same Supabase project.
ESSENZA_SUPABASE_URL=
ESSENZA_SUPABASE_PUBLISHABLE_KEY=
# Set to true to use the offline demo on debug builds.
ESSENZA_LOCAL_DEMO=false
